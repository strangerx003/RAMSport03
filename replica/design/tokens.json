{
  "$scheme": "relialedger/console-v2 — night-bench instrument console",
  "$notes": "Dark charcoal surfaces, one amber phosphor accent, lamp semantics: ok=green, warn=amber-shift, danger=red-fault. Amber is the only hue used for identity; red is reserved for faults.",
  "color": {
    "bg": "#101311",
    "surface": "#191d19",
    "surface-2": "#222822",
    "border": "#2f362e",
    "border-strong": "#454f43",
    "text": "#e9ece6",
    "text-muted": "#a2ab9d",
    "text-faint": "#79817a",
    "accent": "#f2a33c",
    "accent-hi": "#ffc168",
    "on-accent": "#20150a",
    "accent-dim": "#b87d2c",
    "ok": "#63d99b",
    "ok-dim": "#2f6b4f",
    "warn": "#ffd166",
    "danger": "#ff8570",
    "danger-hard": "#e04b38",
    "on-dark": "#f2f4ef"
  },
  "font": {
    "mono": "Cascadia Code / JetBrains Mono fallback stack",
    "sans": "Segoe UI / system stack",
    "scale": "10, 11, 12.5, 14, 22, 28 px (console: labels 10-11, body 12.5-14, readouts 22-28)"
  },
  "space": {
    "base": "4px; console gauges padded 12-16",
    "scale": "2, 4, 8, 12, 16, 24, 40"
  },
  "radius": {
    "bezel": "6px (instrument bezel)",
    "lamp": "999px (status lamps only)"
  },
  "shadow": {
    "bezel": "inset top light / bottom dark, plus 1px outer border-strong",
    "lift": "0 6px 20px rgba(0,0,0,0.35)",
    "glow": "0 0 16px rgba(242,163,60,0.28) on amber readouts"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-2"],
    ["text-faint", "surface", "large"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-2"],
    ["accent", "surface", "large"],
    ["accent", "bg", "large"],
    ["accent-hi", "surface"],
    ["accent-dim", "surface", "large"],
    ["ok", "surface"],
    ["warn", "surface"],
    ["danger", "surface"],
    ["on-accent", "accent"],
    ["on-accent", "accent-hi"]
  ]
}
